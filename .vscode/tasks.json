{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build and run DigitalShelf",
            "type": "process",
            "command": "bash",
            "args": [
                "${workspaceFolder}/run-wsl.sh"
            ],
            "windows": {
                "command": "cmd.exe",
                "args": [
                    "/d",
                    "/c",
                    "${workspaceFolder}\\run-mingw.cmd"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "dedicated"
            }
        }
    ]
}